# Base URL of the Cloud Run API, with no trailing slash.
# Leave blank to use same-origin /api (handy with the Vite dev proxy).
VITE_API_BASE_URL=https://clinical-trial-api-xxxxxxxx-ts.a.run.app

# Used only by `npm run dev` to proxy /api to a locally running backend.
VITE_DEV_API=http://localhost:8080
